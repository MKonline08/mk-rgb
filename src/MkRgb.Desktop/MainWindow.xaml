<Window x:Class="MkRgb.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MK RGB" Width="1360" Height="900" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text" FontSize="13">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#15181A" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="18,26,18,16">
    <StackPanel DockPanel.Dock="Top" Margin="10,0,0,30"><StackPanel Orientation="Horizontal"><Border Background="{StaticResource Accent}" CornerRadius="5" Width="30" Height="30"><TextBlock Text="M" Foreground="#14271F" FontWeight="Bold" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="MK RGB" FontSize="21" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Text="LIGHT  /  COOL  /  CREATE" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="10,20,0,0"><TextBlock Text="LOCAL CONTROL" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="Windows · Open source" FontSize="11" Margin="0,8,0,4"/><TextBlock Text="0.1.2 · Development" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel>
    <ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" SelectionChanged="Navigate" SelectedIndex="0">
     <ListBox.Resources><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,12"/><Setter Property="Margin" Value="0,3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#283B34"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#40534A"/><Setter TargetName="B" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.Resources>
     <ListBoxItem Content="Lighting"/><ListBoxItem Content="Devices"/><ListBoxItem Content="Presets"/>
     <ListBoxItem Content="SYSTEM" IsEnabled="False" IsHitTestVisible="False" FontSize="9" Foreground="{StaticResource Muted}" Padding="12,20,12,2"/>
     <ListBoxItem Content="Monitoring"/><ListBoxItem Content="Cooling"/><ListBoxItem Content="Settings"/>
     <ListBoxItem Content="Advanced"/>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,13"><DockPanel><StackPanel x:Name="ProfileTools" DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="PROFILE" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox x:Name="Profiles" Width="170" ItemsSource="{Binding Settings.Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding Profile, Mode=TwoWay}" Margin="0"/><Button Content="Save profile" Style="{StaticResource Primary}" Margin="12,0,0,0" Click="SaveProfile"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageHeading" Text="Lighting" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Make every light yours." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
   <ScrollViewer Grid.Row="1"><ContentControl x:Name="PageContent" Margin="28,25,28,24"/></ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#15181A" Padding="28,10"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Connection}" Foreground="{StaticResource Accent}" FontSize="11" Margin="20,0,0,0"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11" MaxHeight="48"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
