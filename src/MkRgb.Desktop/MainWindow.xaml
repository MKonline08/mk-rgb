<Window x:Class="MkRgb.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MK RGB" Width="1360" Height="900" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text" FontSize="13">
 <!-- Our own dark title bar: the system frame keeps resizing, snapping, the drop shadow, and rounded corners. -->
 <WindowChrome.WindowChrome>
  <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="NavIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Icons}"/><Setter Property="FontSize" Value="16"/><Setter Property="Width" Value="22"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="NavLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="13.5"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="GroupLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#6F7A83"/></Style>
 </Window.Resources>
 <Grid x:Name="Frame">
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <!-- Title bar: brand over the sidebar, drag area and caption buttons over the content -->
  <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
    <!-- Fire logo (Assets/mk-logo.xaml), loaded and animated from code -->
    <ContentControl x:Name="LogoHost" Width="26" Height="26" Focusable="False">
     <ContentControl.Effect><DropShadowEffect x:Name="LogoGlow" Color="#FF6A00" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/></ContentControl.Effect>
    </ContentControl>
    <TextBlock Text="MK RGB" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
   </StackPanel>
  </Border>
  <DockPanel Grid.Column="1" Background="{StaticResource Bg}">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
    <Button Style="{StaticResource Caption}" Content="&#xE921;" Click="MinimizeClick" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
    <Button x:Name="MaximizeButton" Style="{StaticResource Caption}" Content="&#xE922;" Click="MaximizeClick" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize" AutomationProperties.Name="Maximize"/>
    <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" Click="CloseClick" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close to tray" AutomationProperties.Name="Close"/>
   </StackPanel>
   <Border/>
  </DockPanel>

  <!-- Sidebar -->
  <Border Grid.Row="1" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="14,2,14,16">
    <!-- Live status -->
    <Border DockPanel.Dock="Bottom" Background="#181C20" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
     <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
       <Grid Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
        <Ellipse x:Name="RgbPulse" Fill="{StaticResource Warn}" Opacity="0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform x:Name="RgbPulseScale"/></Ellipse.RenderTransform></Ellipse>
        <Ellipse x:Name="RgbDot" Fill="{StaticResource Muted}"/>
       </Grid>
       <TextBlock Text="{Binding RgbStatus}" FontSize="12"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Ellipse x:Name="ServiceDot" Width="8" Height="8" Fill="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding ServiceStatus}" FontSize="12"/></StackPanel>
      <TextBlock Text="v0.1.2 &#183; preview" FontSize="10" Foreground="#6F7A83"/>
     </StackPanel>
    </Border>

    <ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" SelectionChanged="Navigate" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Once">
     <ListBoxItem Style="{StaticResource NavHeader}"><TextBlock Text="LIGHTING" Style="{StaticResource GroupLabel}"/></ListBoxItem>
     <ListBoxItem Style="{StaticResource Nav}" Tag="Lighting" IsSelected="True"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Style="{StaticResource NavIcon}"/><TextBlock Text="Lighting" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
     <ListBoxItem Style="{StaticResource Nav}" Tag="Devices"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE772;" Style="{StaticResource NavIcon}"/><TextBlock Text="Devices" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
     <ListBoxItem Style="{StaticResource Nav}" Tag="Presets"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource NavIcon}"/><TextBlock Text="Presets" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
     <ListBoxItem Style="{StaticResource NavHeader}"><TextBlock Text="SYSTEM" Style="{StaticResource GroupLabel}"/></ListBoxItem>
     <ListBoxItem Style="{StaticResource Nav}" Tag="Overview"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock Text="Overview" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
     <ListBoxItem Style="{StaticResource Nav}" Tag="Monitoring"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" Style="{StaticResource NavIcon}"/><TextBlock Text="Monitoring" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
     <ListBoxItem Style="{StaticResource Nav}" Tag="Cooling"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9CA;" Style="{StaticResource NavIcon}"/><TextBlock Text="Cooling" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
     <ListBoxItem Style="{StaticResource Nav}" Tag="Settings"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><TextBlock Text="Settings" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
     <ListBoxItem Style="{StaticResource NavHeader}"><TextBlock Text="ADVANCED" Style="{StaticResource GroupLabel}"/></ListBoxItem>
     <ListBoxItem Style="{StaticResource Nav}" Tag="Layout"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" Style="{StaticResource NavIcon}"/><TextBlock Text="Layout" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
     <ListBoxItem Style="{StaticResource Nav}" Tag="Studio"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE771;" Style="{StaticResource NavIcon}"/><TextBlock Text="Effect studio" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
     <ListBoxItem Style="{StaticResource Nav}" Tag="Automations"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EE;" Style="{StaticResource NavIcon}"/><TextBlock Text="Automations" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
    </ListBox>
   </DockPanel>
  </Border>

  <!-- Content -->
  <Grid Grid.Row="1" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="30,4,24,16">
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <CheckBox Style="{StaticResource Switch}" Content="Lighting" IsChecked="{Binding LightingEnabled, Mode=TwoWay}" Margin="0,0,22,0" ToolTip="Send lighting to your devices. Turning this off leaves devices on their last color." AutomationProperties.Name="Lighting output"/>
      <StackPanel x:Name="ProfileTools" Orientation="Horizontal">
       <TextBlock Text="Profile" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <ComboBox x:Name="Profiles" Width="170" ItemsSource="{Binding Settings.Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding Profile, Mode=TwoWay}" Margin="0" AutomationProperties.Name="Active profile"/>
       <Button Content="Save" Margin="10,0,0,0" Click="SaveProfile" ToolTip="Save the current profile"/>
      </StackPanel>
     </StackPanel>
     <StackPanel x:Name="Heading" VerticalAlignment="Center">
      <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
      <TextBlock x:Name="PageHeading" Text="Lighting" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock x:Name="PageSubtitle" Text="" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,3,0,0"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <ScrollViewer x:Name="PageScroll" Grid.Row="1"><ContentControl x:Name="PageContent" Margin="30,24,30,24"/></ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource Sidebar}" Padding="30,9">
    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Connection}" Foreground="{StaticResource Muted}" FontSize="11" Margin="20,0,0,0"/><TextBlock x:Name="StatusText" Text="{Binding Status}" Foreground="#C4CCD1" FontSize="12" MaxHeight="48" TextTrimming="CharacterEllipsis"/></DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
