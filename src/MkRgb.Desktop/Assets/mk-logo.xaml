<!-- MK RGB fire mark. One vector source: the app loads it (and animates the flame), and
     scripts/make-icon.ps1 renders it into mk-rgb.ico. Drawn on a 64 x 64 grid. -->
<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform">
 <Grid Width="64" Height="64">
  <!-- Charcoal tile with a warm ember glow rising from the bottom -->
  <Rectangle RadiusX="15" RadiusY="15">
   <Rectangle.Fill>
    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1B0F0C" Offset="0"/><GradientStop Color="#2A0D06" Offset="0.65"/><GradientStop Color="#4A1406" Offset="1"/></LinearGradientBrush>
   </Rectangle.Fill>
  </Rectangle>
  <Rectangle RadiusX="15" RadiusY="15">
   <Rectangle.Fill>
    <RadialGradientBrush Center="0.5,0.82" GradientOrigin="0.5,0.9" RadiusX="0.62" RadiusY="0.55"><GradientStop x:Name="EmberColor" Color="#A0FF6A00" Offset="0"/><GradientStop Color="#00FF3B1F" Offset="1"/></RadialGradientBrush>
   </Rectangle.Fill>
  </Rectangle>
  <Rectangle RadiusX="15" RadiusY="15" Stroke="#40FF9A5A" StrokeThickness="1"/>

  <Canvas Width="64" Height="64">
   <!-- Outer flame: deep red tips into orange -->
   <Path x:Name="Outer" Data="M32,4 C35,12 44,17 47.5,27 C51,38 48.5,50 40.5,56 C36,59.5 28,59.5 23.5,56 C15.5,50 13.5,40 17.5,30.5 C19.5,25.5 22.5,22.5 23.5,17.5 C25.5,22.5 26.5,26 28.5,27.5 C27.5,19.5 28.5,11.5 32,4 Z">
    <Path.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#FF1F4F" Offset="0"/><GradientStop Color="#FF3B1F" Offset="0.3"/><GradientStop Color="#FF7A00" Offset="0.75"/><GradientStop Color="#FFA41F" Offset="1"/></LinearGradientBrush></Path.Fill>
    <Path.RenderTransform><ScaleTransform x:Name="OuterScale" CenterX="32" CenterY="58"/></Path.RenderTransform>
   </Path>
   <!-- Side tongue -->
   <Path x:Name="Tongue" Data="M45,9 C46.5,13.5 50,16 48.5,22 C47,18.5 44,16.5 45,9 Z" Fill="#FF4A2A">
    <Path.RenderTransform><ScaleTransform x:Name="TongueScale" CenterX="47" CenterY="22"/></Path.RenderTransform>
   </Path>
   <!-- Middle flame: orange into gold -->
   <Path Data="M32,17 C35.5,24.5 42.5,29.5 42.5,40 C42.5,49.5 37.5,55.5 32,55.5 C26.5,55.5 21.5,50.5 21.5,43 C21.5,37 25.5,33 26.5,28 C27.5,32 29.5,34 31,35 C30,29 30,23 32,17 Z">
    <Path.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#FF8A00" Offset="0"/><GradientStop Color="#FFB020" Offset="0.55"/><GradientStop Color="#FFD54A" Offset="1"/></LinearGradientBrush></Path.Fill>
    <Path.RenderTransform><ScaleTransform x:Name="MidScale" CenterX="32" CenterY="56"/></Path.RenderTransform>
   </Path>
   <!-- White-hot core -->
   <Path Data="M32,29 C34.5,34.5 39.5,38 39.5,44.5 C39.5,50 36.5,53.5 32,53.5 C27.5,53.5 24.5,50 24.5,45.5 C24.5,41.5 27.5,39.5 28.5,36 C29.5,38.5 30.5,39.5 31.5,40 C30.5,36.5 30.5,32.5 32,29 Z">
    <Path.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#FFE27A" Offset="0"/><GradientStop Color="#FFF6CF" Offset="1"/></LinearGradientBrush></Path.Fill>
    <Path.RenderTransform><ScaleTransform x:Name="CoreScale" CenterX="32" CenterY="54"/></Path.RenderTransform>
   </Path>
  </Canvas>

  <!-- MK, burned into the base of the flame -->
  <TextBlock x:Name="Letters" Text="MK" FontFamily="Segoe UI Black, Segoe UI" FontWeight="Black" FontSize="13" Foreground="#4A1004" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
   <TextBlock.Effect><DropShadowEffect Color="#FFF3C4" BlurRadius="3" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
  </TextBlock>
 </Grid>
</Viewbox>
